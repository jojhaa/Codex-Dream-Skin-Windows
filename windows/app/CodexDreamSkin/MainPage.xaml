<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CodexDreamSkin.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    SizeChanged="MainPage_SizeChanged"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource KannaShellOverlayBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="GlobalHeader"
            Padding="18,0"
            Background="{ThemeResource StudioPaneBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock
                    x:Uid="StudioBrandEyebrow"
                    FontSize="10"
                    FontWeight="SemiBold"
                    CharacterSpacing="160"
                    Foreground="{ThemeResource KannaAccentBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        x:Uid="StudioBrandTitle"
                        FontSize="22"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="WorkspaceModeContext"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                x:Name="GlobalActions"
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8">
                <Button x:Name="DashboardModeButton" Tag="dashboard" Click="ModeButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <SymbolIcon Symbol="Home" />
                        <TextBlock x:Uid="DashboardNavLabel" />
                    </StackPanel>
                </Button>
                <Button x:Name="ThemesModeButton" Tag="themes" Click="ModeButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <SymbolIcon Symbol="Pictures" />
                        <TextBlock x:Uid="ThemesNavLabel" />
                    </StackPanel>
                </Button>
                <Button x:Name="DiagnosticsModeButton" Tag="diagnostics" Click="ModeButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <SymbolIcon Symbol="Repair" />
                        <TextBlock x:Uid="DiagnosticsNavLabel" />
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsModeButton" Tag="settings" Click="ModeButton_Click">
                    <SymbolIcon Symbol="Setting" />
                </Button>
            </StackPanel>
        </Grid>

        <Frame
            x:Name="ContentFrame"
            Grid.Row="1"
            Background="{ThemeResource KannaShellOverlayBrush}"
            IsTabStop="False" />
    </Grid>
</Page>
