<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CodexDreamSkin.Controls.CodexPreviewFixture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="PreviewFlatButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="PreviewRailButtonStyle" TargetType="Button" BasedOn="{StaticResource PreviewFlatButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#FF17324B" />
        </Style>
        <Style x:Key="PreviewRailSelectedButtonStyle" TargetType="Button" BasedOn="{StaticResource PreviewRailButtonStyle}">
            <Setter Property="Background" Value="#AA0A69B7" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="PreviewSceneButtonStyle" TargetType="Button" BasedOn="{StaticResource PreviewFlatButtonStyle}">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#B8E8F3FA" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#22030F1C">
        <Viewbox
            Stretch="Uniform"
            StretchDirection="Both"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid Width="1922" Height="1034" Background="#24081729">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Image
                    x:Name="PreviewBackgroundImage"
                    Grid.RowSpan="2"
                    Stretch="UniformToFill" />
                <Border
                    Grid.RowSpan="2"
                    Background="#2204192C"
                    IsHitTestVisible="False" />

                <Grid
                    Padding="12,0"
                    Background="#F207192B"
                    BorderBrush="#55334B62"
                    BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
                        <FontIcon Glyph="&#xE700;" FontSize="13" Foreground="#FFC9D9E7" />
                        <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="#FFC9D9E7" />
                        <FontIcon Glyph="&#xE72A;" FontSize="13" Foreground="#FFC9D9E7" />
                        <TextBlock x:Uid="PreviewChromeMenus" Foreground="#FFF1F7FB" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                        <TextBlock x:Name="PreviewStatus" Visibility="Collapsed" />
                        <TextBlock x:Name="PreviewChromeSignature" x:Uid="PreviewBrandSignature" Foreground="#FFF1F7FB" FontSize="14" FontStyle="Italic" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE921;" FontSize="12" Foreground="#FFC9D9E7" />
                        <FontIcon Glyph="&#xE922;" FontSize="12" Foreground="#FFC9D9E7" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="PreviewHomeScene" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="275" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid BorderBrush="#55334B62" BorderThickness="0,0,1,0" Padding="8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Image
                            x:Name="PreviewSidebarImage"
                            Grid.RowSpan="4"
                            Margin="-8"
                            Stretch="UniformToFill"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="PreviewSidebarMaterial"
                            Grid.RowSpan="4"
                            Margin="-8"
                            Background="#C8082037"
                            IsHitTestVisible="False" />
                        <Grid Margin="0,0,0,10">
                            <Border Width="152" Height="32" HorizontalAlignment="Left" Background="#E61070C4" BorderBrush="#AA79C6FF" BorderThickness="1" CornerRadius="6" Padding="10,0">
                                <Grid>
                                    <TextBlock x:Uid="PreviewCodexTitle" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="⌄" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Button HorizontalAlignment="Right" Style="{StaticResource PreviewFlatButtonStyle}" Background="#A507192B" Foreground="White" Padding="8">
                                <FontIcon Glyph="&#xE721;" FontSize="15" />
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="2">
                            <Button x:Uid="PreviewNewTaskButton" Tag="task" Click="SceneButton_Click" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                            <Button x:Uid="PreviewPullRequestButton" Tag="task" Click="SceneButton_Click" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                            <Button x:Uid="PreviewSitesButton" Tag="home" Click="SceneButton_Click" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                            <Button x:Uid="PreviewScheduledButton" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                            <Button x:Uid="PreviewPluginsButton" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="5,22,5,0" Spacing="11">
                            <TextBlock x:Uid="PreviewPinnedLabel" Foreground="#FFD5E7F3" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Uid="PreviewProjectOne" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Uid="PreviewProjectsLabel" Foreground="#FFD5E7F3" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock x:Uid="PreviewRecentLabel" Foreground="#FFD5E7F3" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="3" Background="#7D07192B" CornerRadius="8" Padding="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="24" Height="24" Fill="#FF18856B" />
                            <TextBlock Grid.Column="1" x:Uid="PreviewLocalUser" Foreground="White" VerticalAlignment="Center" />
                            <Button Grid.Column="2" x:Uid="PreviewSidebarSettingsButton" Tag="settings" Click="SceneButton_Click" Style="{StaticResource PreviewFlatButtonStyle}" Foreground="White" Padding="8,4" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="PreviewHomeHeaderMaterial" Padding="24,0" Background="#D00A2036">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="26" Height="26" Fill="#FFED7891" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="PreviewName" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Uid="PreviewHomeEdition" Foreground="#FFBFD3E1" FontSize="8" CharacterSpacing="140" />
                            </StackPanel>
                            <TextBlock x:Name="PreviewHomeSignature" Grid.Column="2" x:Uid="PreviewBrandSignature" Foreground="#FFEAF5FB" FontSize="16" FontStyle="Italic" VerticalAlignment="Center" Margin="0,0,46,0" />
                        </Grid>
                        <Canvas Grid.Row="1">
                            <Border x:Name="PreviewHomeWorkspaceMaterial" Width="1647" Height="949" Background="#2B04182B" />

                            <Border x:Name="PreviewDecorationRibbon" Canvas.Left="752" Canvas.Top="206" Background="#D5239BE1" CornerRadius="2" Padding="22,5">
                                <TextBlock x:Name="PreviewDecorationRibbonText" x:Uid="PreviewBlueMomentLabel" Foreground="White" FontSize="9" FontWeight="SemiBold" CharacterSpacing="180" />
                            </Border>

                            <StackPanel Canvas.Left="500" Canvas.Top="635" Width="700" Spacing="14">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <TextBlock x:Uid="PreviewHomePromptPrefix" Foreground="White" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Background="#5CFFFFFF" BorderBrush="#AAE4F2FA" BorderThickness="1" CornerRadius="18" Padding="12,4">
                                        <TextBlock x:Uid="PreviewSelectedProjectPill" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock x:Uid="PreviewHomePromptSuffix" Foreground="White" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Uid="PreviewHomeSubtitle" Foreground="#F0FFFFFF" FontSize="13" TextAlignment="Center" />
                            </StackPanel>

                            <Grid Canvas.Left="378" Canvas.Top="771" Width="906" Height="164">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="100" />
                                </Grid.RowDefinitions>
                                <Border Background="#B51A354E" BorderBrush="#755D7890" BorderThickness="1" CornerRadius="16,16,0,0" Padding="16,9">
                                    <StackPanel Spacing="5">
                                        <TextBlock x:Uid="PreviewProjectSelectorLabel" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <FontIcon Glyph="&#xE8B7;" Foreground="#FFF26A74" FontSize="13" />
                                            <TextBlock x:Uid="PreviewProjectWindows" Foreground="White" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Background="#B3132D46" BorderBrush="#755D7890" BorderThickness="1,0,1,1" CornerRadius="0,0,16,16" Padding="16,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="30" />
                                        </Grid.RowDefinitions>
                                        <TextBox
                                            x:Name="PreviewComposerTextBox"
                                            x:Uid="PreviewComposerTextBox"
                                            Background="Transparent"
                                            Foreground="White"
                                            BorderThickness="0"
                                            AcceptsReturn="True"
                                            FontSize="14" />
                                        <Grid Grid.Row="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                                <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="#FFE0EDF5" />
                                                <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#FFE0EDF5" />
                                                <TextBlock x:Uid="PreviewComposerCustom" Foreground="#FFE0EDF5" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="14">
                                                <TextBlock x:Uid="PreviewComposerMode" Foreground="#FFF1F7FB" FontSize="12" />
                                                <FontIcon Glyph="&#xE720;" FontSize="13" Foreground="#FFF1F7FB" />
                                                <Button x:Uid="PreviewSendButton" Click="SendButton_Click" Style="{StaticResource PreviewFlatButtonStyle}" Background="#FF39769C" Foreground="White" Padding="9,6">
                                                    <FontIcon Glyph="&#xE74A;" FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Ellipse Width="26" Height="26" Fill="#FFF16B85" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-13,0,0,0" />
                            </Grid>

                            <Border x:Name="PreviewPolaroidCard" Canvas.Left="1510" Canvas.Top="716" Width="110" Height="156" Background="#F6FFFFFF" BorderBrush="#3379B8FF" BorderThickness="1" Padding="7" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform x:Name="PreviewPolaroidRotation" Angle="4" />
                                </Border.RenderTransform>
                                <Grid>
                                    <Image x:Name="PreviewPolaroidImage" Stretch="UniformToFill" />
                                    <TextBlock x:Name="PreviewPolaroidCaptionText" x:Uid="PreviewPolaroidCaption" Foreground="#FF76B9E7" FontSize="7" FontWeight="SemiBold" CharacterSpacing="120" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                </Grid>
                            </Border>
                        </Canvas>
                    </Grid>
                </Grid>

                <Grid x:Name="PreviewTaskScene" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="275" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="PreviewTaskSidebarMaterial" Background="#C80A2239" BorderBrush="#553D536B" BorderThickness="0,0,1,0" Padding="10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="PreviewCodexTitle" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                        <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="2">
                            <Button x:Uid="PreviewNewTaskButton" Tag="home" Click="SceneButton_Click" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                            <Button x:Uid="PreviewPullRequestButton" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                            <Button x:Uid="PreviewSitesButton" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="5,20,5,0" Spacing="9">
                            <TextBlock x:Uid="PreviewProjectsLabel" Foreground="#BFD7E8F4" FontSize="11" />
                            <TextBlock x:Uid="PreviewProjectOne" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                            <Border Background="#B724679B" CornerRadius="7" Padding="12,8">
                                <TextBlock x:Uid="PreviewTaskTitle" Foreground="White" FontSize="13" />
                            </Border>
                            <TextBlock x:Uid="PreviewProjectTwo" Foreground="#E5FFFFFF" FontSize="13" />
                            <TextBlock x:Uid="PreviewProjectThree" Foreground="#E5FFFFFF" FontSize="13" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" x:Uid="PreviewLocalUser" Foreground="White" Margin="8" />
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="PreviewTaskHeaderMaterial" Background="#B7081E34" Padding="18,0">
                            <TextBlock x:Uid="PreviewTaskTitle" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                                <Button x:Uid="PreviewOpenLocationButton" Style="{StaticResource PreviewSceneButtonStyle}" />
                                <FontIcon Glyph="&#xE712;" Foreground="White" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Padding="70,26,70,22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Width="900" HorizontalAlignment="Center" Spacing="16">
                                    <TextBlock x:Uid="PreviewTaskElapsed" Foreground="#E8FFFFFF" FontSize="12" />
                                    <Border Background="#B22C4862" CornerRadius="10" Padding="16,14">
                                        <TextBlock x:Uid="PreviewAssistantMessage" Foreground="White" FontSize="14" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock x:Uid="PreviewTaskCommandStatus" Foreground="#CFE5F2FA" FontSize="12" />
                                    <Border Background="#B22C4862" CornerRadius="10" Padding="16,14">
                                        <TextBlock x:Uid="PreviewTaskDetailMessage" Foreground="White" FontSize="14" TextWrapping="Wrap" />
                                    </Border>
                                    <Border x:Name="PreviewConversationResult" Background="#B22C4862" CornerRadius="10" Padding="16,14" Visibility="Collapsed">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="PreviewUserMessageText" Foreground="White" FontSize="14" TextWrapping="Wrap" />
                                            <TextBlock x:Uid="PreviewSimulatedReply" Foreground="#D8ECF6FC" FontSize="13" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <Grid Grid.Row="1" Width="906" MinHeight="100" Background="#E61B344C" BorderBrush="#775C7790" BorderThickness="1" CornerRadius="16" Padding="16,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="30" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="TaskComposerTextBox" x:Uid="PreviewComposerTextBox" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" />
                                <Grid Grid.Row="1">
                                    <TextBlock x:Uid="PreviewComposerMode" Foreground="#CFE5F2FA" FontSize="12" VerticalAlignment="Center" />
                                    <Button x:Uid="PreviewSendButton" Click="TaskSendButton_Click" HorizontalAlignment="Right" Style="{StaticResource PreviewFlatButtonStyle}" Background="#FF4B6D83" Foreground="White" Padding="10,6">
                                        <FontIcon Glyph="&#xE74A;" FontSize="13" />
                                    </Button>
                                </Grid>
                            </Grid>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="220" Margin="0,10,-42,0" Background="#C817344F" CornerRadius="14" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Uid="PreviewEnvironmentTitle" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Uid="PreviewEnvironmentChanges" Foreground="#E7F5FBFF" FontSize="12" />
                                    <TextBlock x:Uid="PreviewEnvironmentLocal" Foreground="#E7F5FBFF" FontSize="12" />
                                    <TextBlock x:Uid="PreviewEnvironmentBranch" Foreground="#E7F5FBFF" FontSize="12" />
                                    <Rectangle Height="1" Fill="#446D879B" />
                                    <TextBlock x:Uid="PreviewEnvironmentProcesses" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="dotnet build" Foreground="#D6E9F4FB" FontSize="11" />
                                    <TextBlock Text="node theme-manager-source.test.mjs" Foreground="#D6E9F4FB" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="PreviewSettingsScene" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="275" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="PreviewSettingsSidebarMaterial" Background="#D20A2239" BorderBrush="#553D536B" BorderThickness="0,0,1,0" Padding="10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button x:Uid="PreviewBackToAppButton" Tag="home" Click="SceneButton_Click" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                        <TextBox Grid.Row="1" x:Uid="PreviewSettingsSearchBox" Margin="0,10,0,16" Background="#6725415B" Foreground="White" BorderBrush="#557E97AB" />
                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="PreviewSettingsPersonalLabel" Foreground="#AFC9DAE7" FontSize="11" Margin="8,0,0,4" />
                                <Button x:Uid="PreviewSettingsGeneral" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                                <Button x:Uid="PreviewSettingsProfile" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                                <Button x:Uid="PreviewSettingsAppearance" Style="{StaticResource PreviewRailSelectedButtonStyle}" />
                                <Button x:Uid="PreviewSettingsLanguageNav" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                                <Button x:Uid="PreviewSettingsConfiguration" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                                <Button x:Uid="PreviewSettingsPersonalization" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                                <Button x:Uid="PreviewSettingsNotifications" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                                <Button x:Uid="PreviewSettingsShortcuts" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                                <Button x:Uid="PreviewSettingsUsage" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                                <Button x:Uid="PreviewSettingsAccount" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                                <TextBlock x:Uid="PreviewSettingsIntegrationLabel" Foreground="#AFC9DAE7" FontSize="11" Margin="8,14,0,4" />
                                <Button x:Uid="PreviewSettingsExtensions" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                                <Button x:Uid="PreviewSettingsBrowser" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                                <Button x:Uid="PreviewSettingsComputer" Style="{StaticResource PreviewRailButtonStyle}" Foreground="White" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Width="1100" HorizontalAlignment="Center" Padding="0,64,0,50" Spacing="18">
                            <TextBlock x:Uid="PreviewSettingsAppearanceTitle" Foreground="White" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock x:Uid="PreviewSettingsThemeSection" Foreground="#E8FFFFFF" FontSize="14" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Height="176" Background="#995D6570" CornerRadius="10" Padding="12">
                                    <TextBlock x:Uid="PreviewThemeSystem" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                </Border>
                                <Border Grid.Column="1" Height="176" Background="#EAF8FAFC" CornerRadius="10" Padding="12">
                                    <TextBlock x:Uid="PreviewThemeLight" Foreground="#FF17324B" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                </Border>
                                <Border Grid.Column="2" Height="176" Background="#E52B2D31" BorderBrush="White" BorderThickness="3" CornerRadius="10" Padding="12">
                                    <TextBlock x:Uid="PreviewThemeDark" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                </Border>
                            </Grid>
                            <Border Background="#B716314A" CornerRadius="12" Padding="18">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <TextBlock x:Uid="PreviewSettingsLanguage" Foreground="White" VerticalAlignment="Center" />
                                        <ComboBox HorizontalAlignment="Right" Width="180" SelectedIndex="0">
                                            <ComboBoxItem x:Uid="PreviewLanguageChinese" />
                                            <ComboBoxItem x:Uid="PreviewLanguageEnglish" />
                                        </ComboBox>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#445F788E" />
                                    <Grid>
                                        <TextBlock x:Uid="PreviewSettingsTheme" Foreground="White" VerticalAlignment="Center" />
                                        <ToggleSwitch HorizontalAlignment="Right" IsOn="True" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="#445F788E" />
                                    <Grid>
                                        <TextBlock x:Uid="PreviewSettingsNotificationsLabel" Foreground="White" VerticalAlignment="Center" />
                                        <ToggleSwitch HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <InfoBar x:Uid="PreviewSettingsIsolationInfo" IsOpen="True" IsClosable="False" Severity="Informational" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
                    <Ellipse
                        x:Name="PreviewFocusMarker"
                        Width="30"
                        Height="30"
                        Fill="#2200A4EF"
                        Stroke="White"
                        StrokeThickness="2" />
                </Canvas>

                <Border
                    Grid.Row="1"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Margin="286,0,0,8"
                    Padding="10,4"
                    Background="#AA071A2C"
                    CornerRadius="6">
                    <TextBlock x:Uid="PreviewFooterIsolation" Foreground="#DCECF5FA" FontSize="10" />
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
