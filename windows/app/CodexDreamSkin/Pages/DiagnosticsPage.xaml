<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CodexDreamSkin.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="DiagnosticsPage_Loaded"
    SizeChanged="DiagnosticsPage_SizeChanged">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="DiagnosticsInfoBar"
            Margin="16,12"
            x:Uid="DiagnosticsInfo"
            IsOpen="True"
            IsClosable="False"
            Severity="Success" />

        <Grid
            x:Name="DiagnosticsWorkspace"
            Grid.Row="1"
            ColumnSpacing="0"
            RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HealthColumn" Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="HealthPanel"
                Style="{StaticResource StudioGroupStyle}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <StackPanel Spacing="18">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="DiagnosticsHealthTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Uid="DiagnosticsHealthSubtitle" Style="{StaticResource WorkspaceSubtitleStyle}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            x:Uid="RefreshDiagnostics"
                            Click="RefreshButton_Click"
                            VerticalAlignment="Top" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon x:Name="PackageIcon" Symbol="Accept" Foreground="{ThemeResource KannaSuccessBrush}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock x:Uid="DiagnosticsPackageTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="PackageBodyText" x:Uid="DiagnosticsPackageBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="ReadyStatus" Foreground="{ThemeResource KannaSuccessBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Symbol="Accept" Foreground="{ThemeResource KannaSuccessBrush}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock x:Uid="DiagnosticsAssetsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Uid="DiagnosticsAssetsBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="ReadyStatus" Foreground="{ThemeResource KannaSuccessBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon x:Name="RuntimeIcon" Symbol="Clock" Foreground="{ThemeResource KannaPendingBrush}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock x:Uid="DiagnosticsEngineTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="RuntimeBodyText" x:Uid="DiagnosticsEngineBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="PendingStatus" Foreground="{ThemeResource KannaPendingBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                x:Name="PortsPanel"
                Grid.Column="1"
                Style="{StaticResource StudioGroupStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock x:Uid="DiagnosticsPortsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="PortsSummaryText" x:Uid="DiagnosticsPortsBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="RefreshPortsButton"
                            Grid.Column="1"
                            x:Uid="RefreshPorts"
                            Click="RefreshPortsButton_Click"
                            VerticalAlignment="Center" />
                    </Grid>

                    <InfoBar
                        x:Name="PortActionInfoBar"
                        Grid.Row="1"
                        IsOpen="False"
                        IsClosable="True" />

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PortRowsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Glyph="&#xE839;"
                                            Foreground="{ThemeResource KannaAccentBrush}"
                                            VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="6">
                                            <TextBlock Text="{Binding Status}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button
                                                x:Uid="ClosePortProcess"
                                                Click="ClosePortProcessButton_Click"
                                                IsEnabled="{Binding CanTerminate}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
