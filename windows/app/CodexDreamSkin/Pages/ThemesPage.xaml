                        </StackPanel>

                        <StackPanel x:Name="HistoryInspectorPanel" Visibility="Collapsed" Spacing="10">
                            <TextBlock x:Uid="ThemeStudioHistoryDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Button x:Uid="ThemeStudioOpenHistoryButton" Click="HistoryButton_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <TextBlock x:Name="ReadOnlyHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
    </Grid>
</Page>
