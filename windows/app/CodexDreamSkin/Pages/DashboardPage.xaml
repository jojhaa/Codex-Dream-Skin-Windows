<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CodexDreamSkin.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="DashboardPage_Loaded"
    SizeChanged="DashboardPage_SizeChanged"
    mc:Ignorable="d">

    <ScrollViewer x:Name="RootScrollViewer" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource PageRootStyle}">
            <StackPanel Spacing="6">
                <TextBlock x:Uid="DashboardTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="DashboardSubtitle"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Height="276"
                CornerRadius="20"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid>
                    <Image
                        Source="ms-appx:///Assets/Theme/dream-reference.png"
                        Stretch="UniformToFill" />
                    <Border Background="{ThemeResource KannaHeroOverlayBrush}" />
                    <StackPanel
                        MaxWidth="580"
                        Margin="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Spacing="10">
                        <TextBlock
                            x:Uid="DashboardHeroEyebrow"
                            Foreground="#FFD7ECFF"
                            FontSize="12"
                            FontWeight="SemiBold"
                            CharacterSpacing="120" />
                        <TextBlock
                            x:Uid="DashboardHeroTitle"
                            Foreground="White"
                            FontSize="30"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Uid="DashboardHeroBody"
                            Foreground="#FFF2F8FF"
                            FontSize="15"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="DashboardStatusTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid x:Name="StatusGrid" RowSpacing="12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="AppStatusCard" Grid.ColumnSpan="3" Style="{StaticResource StatusCardStyle}">
                        <StackPanel Spacing="10">
                            <SymbolIcon Symbol="Accept" Foreground="{ThemeResource KannaSuccessBrush}" HorizontalAlignment="Left" />
                            <TextBlock x:Uid="AppStatusTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Uid="AppStatusBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ThemeStatusCard" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource StatusCardStyle}">
                        <StackPanel Spacing="10">
                            <SymbolIcon Symbol="Pictures" Foreground="{ThemeResource KannaSuccessBrush}" HorizontalAlignment="Left" />
                            <TextBlock x:Uid="ThemeStatusTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Uid="ThemeStatusBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="EngineStatusCard" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource StatusCardStyle}">
                        <StackPanel Spacing="10">
                            <SymbolIcon x:Name="EngineStatusIcon" Symbol="Clock" Foreground="{ThemeResource KannaPendingBrush}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="EngineStatusTitleText" x:Uid="EngineStatusTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="EngineStatusBodyText" x:Uid="EngineStatusBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="ApplyThemeButton"
                                    Click="ApplyThemeButton_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Play" />
                                        <TextBlock x:Uid="ApplyTheme" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RefreshStatusButton" x:Uid="RefreshEngine" Click="RefreshStatusButton_Click" />
                                <ProgressRing x:Name="EngineProgressRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </Grid>
            </StackPanel>

            <Border Style="{StaticResource StatusCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="MigrationTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="70%" Foreground="{ThemeResource KannaAccentBrush}" FontWeight="SemiBold" />
                    </Grid>
                    <ProgressBar Value="70" Maximum="100" />
                    <TextBlock x:Uid="MigrationBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <InfoBar
                x:Uid="DashboardInfo"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
